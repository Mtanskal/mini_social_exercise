{% extends "base.html.j2" %}

{% block content %}
<div class="col-md-8 mx-auto">
  <h1 class="text-center border-bottom pb-2 mb-4">Leaderboard</h1>
    <p class="text-center text-muted">
    {% if current_period == 'all' %}
        User points for all time: 10 points per post and 5 points per comment.
    {% else %}
        User points from the last 14 days: 10 points per post and 5 points per comment.
    {% endif %}
    </p>

   <div class="text-center mb-4">
    <div class="btn-group" role="group" aria-label="Leaderboard period">
        {# Let users choose either last 14 days or all time. #}
        <a href="{{ url_for('leaderboard', period='14days') }}"
        class="btn {% if current_period == '14days' %}btn-primary{% else %}btn-light{% endif %}">
        Last 14 days
        </a>
        <a href="{{ url_for('leaderboard', period='all') }}"
        class="btn {% if current_period == 'all' %}btn-primary{% else %}btn-light{% endif %}">
        All time
        </a>
    </div>
  </div>

  {% if users %}
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Rank</th>
          <th scope="col">User</th>
          <th scope="col">Posts</th>
          <th scope="col">Comments</th>
          <th scope="col">Points</th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
        <tr>
          <th scope="row">{{ loop.index }}</th>
          <td>
            <a href="{{ url_for('user_profile', username=user.username) }}">
              {{ user.username }}
            </a>
          </td>
          <td>{{ user.post_count }}</td>
          <td>{{ user.comment_count }}</td>
          <td><strong>{{ user.points }}</strong></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="text-center">There have been no posts or comments in the last 14 days.</p>
  {% endif %}
</div>
{% endblock %}